# Required. Create a Discord bot at https://discord.com/developers/applications
# and grant it only the server/channel read permissions it needs.
DISCORD_BOT_TOKEN=

# Optional defense-in-depth hook. When set, channel reads and list results are
# restricted to these comma-separated Discord channel IDs.
# DISCORD_ALLOWED_CHANNEL_IDS=123456789012345678,234567890123456789

# Optional, mainly for tests and compatible proxies.
# DISCORD_API_BASE_URL=https://discord.com/api/v10
